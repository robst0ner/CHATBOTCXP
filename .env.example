# ---- IA: Gemini (gratis) ----
# Clave gratis en https://aistudio.google.com/apikey
PROVIDER=gemini
GEMINI_API_KEY=pega-aqui-tu-clave
# MODEL=gemini-3.8-flash   (por defecto). Si un día lo retiran, prueba otro modelo flash vigente
# Para usar Claude en vez de Gemini: PROVIDER=anthropic y ANTHROPIC_API_KEY=...

# ---- Página web ----
PORT=3000
# Dominios desde los que se permite llamar a /api/chat si la página vive en otro sitio (separados por coma)
ALLOWED_ORIGINS=
# Login simple: si defines una clave aquí, TODA la página pide esa clave para entrar (sesión de 30 días por dispositivo).
# Déjala vacía para que el sitio quede abierto sin login.
SITE_PASSWORD=
# Llave simple opcional: si la defines, la página debe abrirse con ?k=LLAVE (ej: https://tu-sitio/?k=abc123)
CHAT_ACCESS_KEY=
# Tope de consultas por día para controlar costos
DAILY_MAX=500

# ---- WhatsApp (Meta Cloud API). Déjalo vacío si solo usarás la página ----
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
GRAPH_VERSION=v21.0

# ---- Registro de preguntas ----
# Cualquier texto largo y aleatorio; sirve para anonimizar teléfonos en el registro
LOG_SALT=cambia-esto
